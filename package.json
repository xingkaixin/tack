{
  "name": "tack",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "pnpm --filter @tack/web build",
    "check": "oxlint --deny-warnings apps/web/src && pnpm --filter @tack/web check && cargo clippy --workspace -- -D warnings",
    "format": "pnpm exec oxfmt . && cargo fmt --all",
    "test": "node --env-file-if-exists=.env scripts/test.mjs",
    "start": "pnpm build && node scripts/start.mjs",
    "check:format": "oxfmt --check . && cargo fmt --all --check",
    "test:serve": "node --env-file-if-exists=.env scripts/test-server.mjs",
    "test:acceptance": "node --test scripts/acceptance.test.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "ws": "8.22.0",
    "yjs": "13.6.33"
  },
  "packageManager": "pnpm@12.9.1"
}
